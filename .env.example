# Copy to .env and adjust:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.
#
# Host/port values below describe how YOUR MACHINE reaches each service
# (used when running the backend with `npm run start:dev`).
# docker-compose overrides the hosts for containers (postgres, redis, elasticsearch).

# --- PostgreSQL ---
POSTGRES_USER=cryptoscope
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=cryptoscope
POSTGRES_HOST=localhost
# 5434 on the host avoids clashing with locally installed Postgres servers (5432, 5433)
POSTGRES_PORT=5434

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Elasticsearch / Kibana ---
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_PORT=9200
ES_JAVA_OPTS=-Xms1g -Xmx1g
KIBANA_PORT=5601
# Alias for TLS handshake logs (npm run logs:generate creates it)
HANDSHAKE_INDEX=tls-handshakes
# Search copy of scan findings, written by the scan worker
FINDINGS_INDEX=cryptoscope-findings

# --- Backend (NestJS) ---
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000
# TLS scanner: per-connection timeout and max hosts scanned in parallel
SCAN_TIMEOUT_MS=5000
SCAN_CONCURRENCY=10

# --- Scan job queue (BullMQ on Redis) ---
QUEUE_PREFIX=cryptoscope
SCAN_WORKER_CONCURRENCY=5
# Tries per scan job and first retry delay (doubles each retry: 2s, 4s, ...)
SCAN_JOB_ATTEMPTS=3
SCAN_RETRY_DELAY_MS=2000

# --- Security ---
# REQUIRED. At least 32 random characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=
# Access token lifetime (e.g. 15m, 1h)
JWT_EXPIRES_IN=1h
# Optional: creates this admin on first start (only when no users exist). Password: 12+ characters.
ADMIN_EMAIL=admin@cryptoscope.local
ADMIN_PASSWORD=
# Requests per client IP per window (login has its own, stricter limit of 5/min)
RATE_LIMIT=100
RATE_LIMIT_TTL_MS=60000
# Set to 1 when running behind one reverse proxy/load balancer, so rate limits use the real client IP
TRUST_PROXY_HOPS=0
# SSRF protection: keep false in production. true allows scanning 127.0.0.1, 10.x, 192.168.x, ...
SCAN_ALLOW_PRIVATE_TARGETS=false

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
